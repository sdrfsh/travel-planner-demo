# All optional. Real env vars win over this file; unset paths default to DATA_DIR.
# DATA_DIR defaults to <repo>/data
# DATA_DIR=C:/path/to/your/data
# Override single paths only if they live outside DATA_DIR:
# DB_PATH=C:/path/to/your/data/trips.db
# QDRANT_PATH=C:/path/to/your/data/qdrant
# NOTES_DIR=C:/path/to/your/data/notes
# EVAL_PATH=C:/path/to/your/data/eval.yaml
